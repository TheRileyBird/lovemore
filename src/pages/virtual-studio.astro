---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import { Video, Clock, Smartphone, Gift, Infinity as InfinityIcon } from 'lucide-astro';
import { wlFitVidUrl } from '../data/wellnessliving';
import virtualBanner from '../assets/images/class.jpg';
import fitVidImage from '../assets/images/seated.jpg';

// FitVID lives on WellnessLiving and cannot be embedded — see wlFitVidUrl().
const fitVidUrl = wlFitVidUrl();
// The free category has no viewing restriction, so it plays without an account.
const fitVidFreeUrl = wlFitVidUrl('free');

const benefits = [
	{
		icon: Clock,
		title: 'Short and Doable',
		description: 'Classes designed to fit the time you actually have, not the time you wish you had.'
	},
	{
		icon: Smartphone,
		title: 'Anywhere You Are',
		description: 'Watch on your phone, tablet, or laptop — at home, travelling, or on a lunch break.'
	},
	{
		icon: InfinityIcon,
		title: 'Yours On Demand',
		description: 'Press play whenever it suits you and repeat your favorites as often as you like.'
	}
];
---

<Layout title="Virtual Studio — Love More">
	<Navigation />

	<main id="main-content">
		<!-- Hero Section -->
		<section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden pt-20" aria-labelledby="virtual-heading">
			<div class="absolute inset-0 z-0">
				<img
					src={virtualBanner.src}
					alt=""
					role="presentation"
					class="absolute inset-0 w-full h-full object-cover"
				/>
				<div class="absolute inset-0 bg-gradient-to-b from-neutral-900/60 via-neutral-900/50 to-neutral-900/60"></div>
			</div>

			<div class="relative z-10 container mx-auto px-6 text-center">
				<Video class="w-14 h-14 text-brand mx-auto mb-6 opacity-90" aria-hidden="true" />
				<h1 id="virtual-heading" class="text-5xl md:text-7xl font-display font-bold text-white tracking-wide mb-4">
					Virtual Studio
				</h1>
				<p class="text-2xl text-white/90 font-light">
					Practice Anywhere, Anytime
				</p>
			</div>
		</section>

		<!-- FitVID Section -->
		<section class="py-20 bg-cream-50" aria-labelledby="fitvid-heading">
			<div class="container mx-auto px-6">
				<div class="grid md:grid-cols-2 gap-16 items-center max-w-6xl mx-auto">
					<div class="hidden md:block overflow-hidden rounded-lg aspect-[4/5]">
						<Image
							src={fitVidImage}
							alt="Love More students seated on colorful mats, arms raised in a studio class"
							class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
							{/* lazy, not eager: the wrapper is `hidden` below md, and a display:none
							    image is still fetched when eager — mobile would download a picture it
							    never shows. Lazy skips it there, and on desktop the image sits ~620px
							    down, inside the browser's lazy-load threshold, so it still loads
							    immediately rather than popping in. */}
							loading="lazy"
							widths={[400, 550, 800, 1100]}
							sizes="(min-width: 768px) 544px, 100vw"
						/>
					</div>

					<div class="text-center md:text-left">
						<h2 id="fitvid-heading" class="text-3xl md:text-4xl font-display font-bold text-charcoal mb-6 tracking-wide">
							Introducing FitVID
						</h2>
						<p class="text-lg text-neutral-600 mb-6 leading-relaxed">
							FitVID is our library of short online classes, free for Love More members. Roll
							out your mat at home and move with us whenever the day allows.
						</p>
						<p class="text-lg text-neutral-600 mb-10 leading-relaxed">
							Your videos live in your WellnessLiving account — the same account you use to
							book classes. Sign in and the whole library is waiting for you.
						</p>

						<Button href={fitVidUrl} variant="primary" size="large" external>
							Browse FitVID Classes
						</Button>

						<p class="text-sm text-neutral-500 mt-4">
							Opens WellnessLiving in a new tab. Sign in with your Love More account to watch.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Benefits -->
		<section class="py-16 bg-white" aria-labelledby="benefits-heading">
			<div class="container mx-auto px-6">
				<div class="max-w-5xl mx-auto">
					<h2 id="benefits-heading" class="sr-only">Why practice with FitVID</h2>
					<div class="grid md:grid-cols-3 gap-10">
						{benefits.map((benefit) => (
							<div class="text-center">
								<benefit.icon class="w-10 h-10 text-brand mx-auto mb-5" aria-hidden="true" />
								<h3 class="text-xl font-display font-bold text-charcoal mb-3 tracking-wide">
									{benefit.title}
								</h3>
								<p class="text-neutral-600 leading-relaxed">
									{benefit.description}
								</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- Free Classes — open to anyone, no account needed -->
		<section class="py-20 bg-cream-50" aria-labelledby="free-heading">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl mx-auto text-center">
					<Gift class="w-12 h-12 text-brand mx-auto mb-6" aria-hidden="true" />
					<h2 id="free-heading" class="text-3xl md:text-4xl font-display font-bold text-charcoal mb-6 tracking-wide">
						New Here? Start Free
					</h2>
					<p class="text-lg text-neutral-600 mb-10 leading-relaxed">
						You don't need an account to try us out. A short meditation with Dom and a
						vinyasa flow with JoEllen are free for anyone to watch — press play and see
						how it feels.
					</p>

					<Button href={fitVidFreeUrl} variant="outline" size="large" external>
						Watch Free Classes
					</Button>

					<p class="text-sm text-neutral-500 mt-4">
						No sign-up, no card. Opens in a new tab.
					</p>
				</div>
			</div>
		</section>

		<!-- Call to Action -->
		<section class="py-20 bg-cream">
			<div class="container mx-auto px-6">
				<div class="max-w-3xl mx-auto text-center">
					<h2 class="text-3xl md:text-4xl font-display font-bold text-charcoal mb-6 tracking-wide">
						Prefer In-Person?
					</h2>
					<p class="text-lg text-neutral-600 mb-8 leading-relaxed">
						Nothing beats the energy of practicing together in our studio. Check out our in-studio schedule and join us on the mat.
					</p>
					<Button href="/schedule" variant="primary" size="large">
						View Studio Schedule
					</Button>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
